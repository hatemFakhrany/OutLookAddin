@{
    ViewData["Title"] = "Signed in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Outlook Add-in</title>
</head>
<body style="font-family: 'Segoe UI', sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #eef3f8; color: #172033;">
    <main style="padding: 42px; background: white; border: 1px solid #d8e1eb; text-align: center;">
        <h1>Signed in</h1>
        <p>Welcome, @ViewData["Username"].</p>
    </main>
</body>
</html>